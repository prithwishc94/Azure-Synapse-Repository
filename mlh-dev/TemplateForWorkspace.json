		{
			"name": "[concat(parameters('workspaceName'), '/sp_scd2_prod')]",
			"type": "Microsoft.Synapse/workspaces/notebooks",
			"apiVersion": "2019-06-01-preview",
			"properties": {
				"nbformat": 4,
				"nbformat_minor": 2,
				"bigDataPool": {
					"referenceName": "tempsparkpool",
					"type": "BigDataPoolReference"
				},
				"sessionProperties": {
					"driverMemory": "28g",
					"driverCores": 4,
					"executorMemory": "28g",
					"executorCores": 4,
					"numExecutors": 2,
					"conf": {
						"spark.dynamicAllocation.enabled": "false",
						"spark.dynamicAllocation.minExecutors": "2",
						"spark.dynamicAllocation.maxExecutors": "2",
						"spark.autotune.trackingId": "6003c72e-cba5-49e0-9d5c-3bd6016309eb"
					}
				},
				"metadata": {
					"saveOutput": true,
					"enableDebugMode": false,
					"kernelspec": {
						"name": "synapse_pyspark",
						"display_name": "Synapse PySpark"
					},
					"language_info": {
						"name": "python"
					},
					"a365ComputeOptions": {
						"id": "/subscriptions/6be28b09-038a-4a58-8601-3d76a888b981/resourceGroups/INSURANCE_DEV/providers/Microsoft.Synapse/workspaces/mlh-dev/bigDataPools/tempsparkpool",
						"name": "tempsparkpool",
						"type": "Spark",
						"endpoint": "https://mlh-dev.dev.azuresynapse.net/livyApi/versions/2019-11-01-preview/sparkPools/tempsparkpool",
						"auth": {
							"type": "AAD",
							"authResource": "https://dev.azuresynapse.net"
						},
						"sparkVersion": "3.5",
						"nodeCount": 3,
						"cores": 4,
						"memory": 28,
						"automaticScaleJobs": false
					},
					"sessionKeepAliveTimeout": 30
				},
				"cells": [
					{
						"cell_type": "code",
						"metadata": {},
						"source": [
							"from pyspark.sql.functions import col, lit, current_date, current_timestamp, crc32, abs, concat_ws\n",
							"from delta.tables import DeltaTable\n",
							"\n",
							"# 1. Define Paths\n",
							"source_path = \"abfss://source@storageadflearntcs.dfs.core.windows.net/csvfiles/Emp_Source/customers_scd2_test.csv\"\n",
							"target_path = \"abfss://target@storageadflearntcs.dfs.core.windows.net/deltafiles/customers_delta\"\n",
							"\n",
							"# 2. Read Source\n",
							"df_source = spark.read.option(\"header\", \"true\").csv(source_path)\n",
							"\n",
							"# 3. Load Target Delta Table\n",
							"deltaTable = DeltaTable.forPath(spark, target_path)\n",
							"df_target = deltaTable.toDF()\n",
							"\n",
							"# 4. Identify Existing Active Records That Changed\n",
							"df_active_target = df_target.filter(col(\"IsCurrent\") == 1)\n",
							"\n",
							"# Explicitly compare columns to detect changes (ignoring MD5 entirely)\n",
							"change_condition = (\n",
							"    ~(df_source[\"FirstName\"].eqNullSafe(df_active_target[\"FirstName\"])) |\n",
							"    ~(df_source[\"LastName\"].eqNullSafe(df_active_target[\"LastName\"])) |\n",
							"    ~(df_source[\"City\"].eqNullSafe(df_active_target[\"City\"])) |\n",
							"    ~(df_source[\"State\"].eqNullSafe(df_active_target[\"State\"])) |\n",
							"    ~(df_source[\"Email\"].eqNullSafe(df_active_target[\"Email\"])) |\n",
							"    ~(df_source[\"PhoneNumber\"].cast(\"string\").eqNullSafe(df_active_target[\"PhoneNumber\"].cast(\"string\")))\n",
							")\n",
							"\n",
							"df_updates = df_source.join(\n",
							"    df_active_target,\n",
							"    on=\"CustomerID\",\n",
							"    how=\"inner\"\n",
							").filter(change_condition).select(df_source[\"*\"])\n",
							"\n",
							"# 5. Build Staging Dataset (Merge Key: CustomerID for updates to expire; NULL for new inserts)\n",
							"df_staged = df_source.withColumn(\"MERGE_KEY\", col(\"CustomerID\")) \\\n",
							"    .unionByName(\n",
							"        df_updates.withColumn(\"MERGE_KEY\", lit(None))\n",
							"    )\n",
							"\n",
							"# 6. Execute SCD Type 2 Merge via Python DeltaTable API\n",
							"update_condition = \"\"\"\n",
							"    NOT (target.FirstName <=> src.FirstName) OR \n",
							"    NOT (target.LastName <=> src.LastName) OR \n",
							"    NOT (target.City <=> src.City) OR \n",
							"    NOT (target.State <=> src.State) OR \n",
							"    NOT (target.Email <=> src.Email) OR \n",
							"    NOT (CAST(target.PhoneNumber AS STRING) <=> CAST(src.PhoneNumber AS STRING))\n",
							"\"\"\"\n",
							"\n",
							"deltaTable.alias(\"target\").merge(\n",
							"    source=df_staged.alias(\"src\"),\n",
							"    condition=\"target.CustomerID = src.MERGE_KEY AND target.IsCurrent = 1\"\n",
							").whenMatchedUpdate(\n",
							"    condition=update_condition,\n",
							"    set={\n",
							"        \"IsCurrent\": lit(0),\n",
							"        \"EndDate\": current_date()\n",
							"    }\n",
							").whenNotMatchedInsert(\n",
							"    values={\n",
							"        \"CustomerSK\": abs(crc32(concat_ws(\"_\", col(\"src.CustomerID\"), current_timestamp()))),\n",
							"        \"CustomerID\": col(\"src.CustomerID\"),\n",
							"        \"FirstName\": col(\"src.FirstName\"),\n",
							"        \"LastName\": col(\"src.LastName\"),\n",
							"        \"Email\": col(\"src.Email\"),\n",
							"        \"City\": col(\"src.City\"),\n",
							"        \"State\": col(\"src.State\"),\n",
							"        \"PhoneNumber\": col(\"src.PhoneNumber\"),\n",
							"        \"StartDate\": current_date(),\n",
							"        \"EndDate\": lit(\"9999-12-31\"),\n",
							"        \"IsCurrent\": lit(1)\n",
							"    }\n",
							").execute()\n",
							"\n",
							"print(\"SCD Type 2 Merge completed successfully.\")"
						],
						"outputs": [],
						"execution_count": 1
					}
				]
			},
			"dependsOn": []
		},
